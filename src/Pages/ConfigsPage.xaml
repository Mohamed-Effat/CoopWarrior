<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CoopWarrior.Pages.ConfigsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,40,0">
            <TextBlock Text="Game configs" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Click="New_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="New config">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New config" />
                    </StackPanel>
                </Button>
                <Button Click="Import_Click" AutomationProperties.Name="Import">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>
                <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Open the configs folder" AutomationProperties.Name="Open the configs folder">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentMargin}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Margin="1,8,0,16" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Each game config has its own keys, mouse settings and game filter. Click one to use it. Configs are .kpad text files in the configs folder next to Start.bat, so you can share them or edit them in Notepad." />
                <InfoBar x:Name="MessageBar" IsOpen="False" Margin="0,0,0,8" />
                <StackPanel x:Name="List" Spacing="{StaticResource SettingsCardSpacing}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
