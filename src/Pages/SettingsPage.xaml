<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CoopWarrior.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentMargin}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock Text="Window" Style="{StaticResource GroupHeaderStyle}" Margin="1,16,0,6" />
                <tk:SettingsCard Header="Minimize to the notification area"
                                 Description="Minimizing hides the window from the taskbar. Click the Co-op Warrior icon next to the clock to open it again.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE921;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="MinimizeToggle" Toggled="Toggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Close to the notification area"
                                 Description="The close button hides the window, and the keyboard controller keeps working. To quit, right-click the Co-op Warrior icon next to the clock and choose Exit.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8BB;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="CloseToggle" Toggled="Toggle_Toggled" />
                </tk:SettingsCard>
                <TextBlock Margin="1,8,0,0" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="The icon may sit under the arrow next to the clock. Drag it onto the taskbar to keep it in sight." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
