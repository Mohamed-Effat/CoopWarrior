<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CoopWarrior.Pages.TutorialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="How to use" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentMargin}">
            <Grid MaxWidth="900" HorizontalAlignment="Stretch" RowSpacing="20" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <Viewbox MaxHeight="420" Stretch="Uniform">
                        <Canvas x:Name="Stage" Width="640" Height="300" />
                    </Viewbox>
                </Border>

                <StackPanel Grid.Row="1" Spacing="6" MinHeight="120">
                    <TextBlock x:Name="StepNumber" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="StepTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="StepBody" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Button x:Name="BackButton" Content="Back" MinWidth="110" Click="Back_Click" />
                    <PipsPager x:Name="Pips" HorizontalAlignment="Center" VerticalAlignment="Center" MaxVisiblePips="10"
                               SelectedIndexChanged="Pips_SelectedIndexChanged" />
                    <Button x:Name="NextButton" Content="Next" MinWidth="110" HorizontalAlignment="Right"
                            Style="{StaticResource AccentButtonStyle}" Click="Next_Click" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
