<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CoopWarrior.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentMargin}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="{StaticResource SettingsCardSpacing}">

                <Border Style="{StaticResource CardStyle}" Padding="28" Margin="0,16,0,0">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/CoopWarrior.png" Width="72" Height="72" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Co-op Warrior" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="Turns your keyboard and mouse into an Xbox controller, so one more player can join split-screen games." />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                    <Run Text="Made by" />
                                    <Run Text="Mohamed Effat" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Updates" Style="{StaticResource GroupHeaderStyle}" />
                <tk:SettingsCard x:Name="UpdateCard" Header="Updates">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing x:Name="UpdateRing" Width="20" Height="20" IsActive="False" />
                        <Button x:Name="UpdateButton" Content="Check for updates" Click="UpdateButton_Click" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="AutoCard" Header="Check for updates automatically"
                                 Description="When Co-op Warrior starts, it looks for a new version on GitHub. It looks at most once a day.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE823;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AutoToggle" Toggled="AutoToggle_Toggled" />
                </tk:SettingsCard>

                <TextBlock Text="Built with" Style="{StaticResource GroupHeaderStyle}" />
                <tk:SettingsCard Header="ViGEmBus"
                                 Description="The driver that adds the controller to Windows, by Nefarius Software Solutions. BSD 3-Clause license.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Header="ViGEmClient"
                                 Description="The library that talks to the driver, from the vgamepad project by Yann Bouteiller. MIT license.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Windows App SDK and WinUI 3" Description="The app framework, by Microsoft.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE737;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Windows Community Toolkit" Description="The settings cards on these pages. MIT license.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Velopack" Description="The installer and automatic updates. MIT license.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>

                <TextBlock Text="License" Style="{StaticResource GroupHeaderStyle}" />
                <tk:SettingsCard Header="GNU General Public License v3"
                                 Description="Co-op Warrior is free software. The license adds a permission to use Microsoft's Windows libraries. Click to read the license and the notices for the software above."
                                 IsClickEnabled="True" Click="License_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
