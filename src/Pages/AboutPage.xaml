<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CoopWarrior.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentMargin}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="{StaticResource SettingsCardSpacing}">

                <Border Style="{StaticResource CardStyle}" Padding="28" Margin="0,16,0,0">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/CoopWarrior.png" Width="72" Height="72" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Co-op Warrior" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="Turns your keyboard and mouse into a second Xbox controller, so split-screen games can have another player." />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                    <Run Text="Made by" />
                                    <Run Text="Mohamed Effat" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Built with" Style="{StaticResource GroupHeaderStyle}" />
                <tk:SettingsCard Header="ViGEmBus"
                                 Description="The virtual gamepad driver, by Nefarius Software Solutions. BSD 3-Clause license.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Header="ViGEmClient"
                                 Description="The library that talks to the driver, from the vgamepad project by Yann Bouteiller. MIT license.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Windows App SDK and WinUI 3" Description="The app framework, by Microsoft.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE737;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Windows Community Toolkit" Description="The settings cards on these pages. MIT license.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
