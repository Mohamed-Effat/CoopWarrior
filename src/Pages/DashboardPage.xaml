<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CoopWarrior.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:c="using:CoopWarrior.Controls">

    <Page.Resources>
        <Style x:Key="PlayerBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,3,10,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="PlayerBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentMargin}">
            <StackPanel MaxWidth="{StaticResource DashboardMaxWidth}" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">

                <InfoBar x:Name="DriverBar" IsClosable="False" IsOpen="True" Margin="0,12,0,0">
                    <InfoBar.ActionButton>
                        <Button x:Name="InstallButton" Content="Install driver" Click="Install_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" Title="Could not turn on" />

                <!-- The main switch -->
                <Border Style="{StaticResource CardStyle}" Padding="28,24" Margin="0,4,0,0">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Turn keyboard into a controller" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="Detail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Top" Margin="0,2,0,0">
                                <TextBlock x:Name="ToggleText" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <!-- Only the track is shown; the On/Off text sits on its left, as on Windows settings pages. -->
                                <ToggleSwitch x:Name="PadToggle" Toggled="PadToggle_Toggled" OnContent="" OffContent="" MinWidth="0" Width="40"
                                              AutomationProperties.Name="Turn keyboard into a controller"
                                              RenderTransformOrigin="1,0.5" Margin="12,0,0,0">
                                    <ToggleSwitch.RenderTransform>
                                        <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                    </ToggleSwitch.RenderTransform>
                                </ToggleSwitch>
                            </StackPanel>
                        </Grid>

                        <Viewbox MaxHeight="260">
                            <Grid ColumnSpacing="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:KeyboardView x:Name="Keyboard" Height="172" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <c:ControllerView x:Name="Pad" Width="240" Height="180" />
                                    <StackPanel x:Name="PadBadge" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Opacity="0">
                                        <Border Style="{StaticResource PlayerBadgeStyle}" Background="{ThemeResource SystemFillColorSuccessBrush}">
                                            <TextBlock x:Name="PadBadgeText" Style="{StaticResource PlayerBadgeTextStyle}" />
                                        </Border>
                                        <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Viewbox>

                        <Grid MinHeight="20">
                            <TextBlock x:Name="Caption" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="CaptionHint" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <StackPanel>
                            <Viewbox x:Name="OtherPadsBox" StretchDirection="DownOnly" Visibility="Collapsed">
                                <!-- One per XInput slot, shown while another controller holds that slot. -->
                                <StackPanel x:Name="OtherPads" Orientation="Horizontal" Spacing="40">
                                    <StackPanel Spacing="6" Visibility="Collapsed">
                                        <c:ControllerView Width="136" Height="102" />
                                        <Border Style="{StaticResource PlayerBadgeStyle}"><TextBlock Text="Player 1" Style="{StaticResource PlayerBadgeTextStyle}" /></Border>
                                    </StackPanel>
                                    <StackPanel Spacing="6" Visibility="Collapsed">
                                        <c:ControllerView Width="136" Height="102" />
                                        <Border Style="{StaticResource PlayerBadgeStyle}"><TextBlock Text="Player 2" Style="{StaticResource PlayerBadgeTextStyle}" /></Border>
                                    </StackPanel>
                                    <StackPanel Spacing="6" Visibility="Collapsed">
                                        <c:ControllerView Width="136" Height="102" />
                                        <Border Style="{StaticResource PlayerBadgeStyle}"><TextBlock Text="Player 3" Style="{StaticResource PlayerBadgeTextStyle}" /></Border>
                                    </StackPanel>
                                    <StackPanel Spacing="6" Visibility="Collapsed">
                                        <c:ControllerView Width="136" Height="102" />
                                        <Border Style="{StaticResource PlayerBadgeStyle}"><TextBlock Text="Player 4" Style="{StaticResource PlayerBadgeTextStyle}" /></Border>
                                    </StackPanel>
                                </StackPanel>
                            </Viewbox>
                            <TextBlock x:Name="NoOtherPads" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="No other controllers found. Controllers that Windows sees as Xbox controllers show up here with their player number." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <tk:SettingsCard Header="Player number" Margin="0,4,0,0"
                                 Description="Which player your keyboard is in the game.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE716;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="PlayerBox" MinWidth="220" SelectionChanged="PlayerBox_SelectionChanged"
                              AutomationProperties.Name="Player number">
                        <ComboBoxItem Content="Next free player" />
                        <ComboBoxItem Content="Player 1" />
                        <ComboBoxItem Content="Player 2" />
                        <ComboBoxItem Content="Player 3" />
                        <ComboBoxItem Content="Player 4" />
                    </ComboBox>
                </tk:SettingsCard>

                <InfoBar x:Name="PlayerBar" Severity="Warning" IsClosable="False" IsOpen="False" />

                <tk:SettingsCard Header="Game profile"
                                 Description="The keys and mouse settings for one game. You can add and change profiles on the Profiles page.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ProfileBox" MinWidth="260" MaxWidth="440" DisplayMemberPath="Name"
                              SelectionChanged="ProfileBox_SelectionChanged" AutomationProperties.Name="Game profile" />
                </tk:SettingsCard>

                <InfoBar x:Name="NotesBar" Severity="Informational" IsClosable="False" Title="Tips for this game" />

                <TextBlock Text="Game" Style="{StaticResource GroupHeaderStyle}" />
                <tk:SettingsExpander x:Name="FilterExpander" Header="Only work while the game is in front"
                                     Description="When you switch to another window, your keys work as normal keys again.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE71C;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="OnlyToggle" Toggled="OnlyToggle_Toggled" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Game program" Description="Start the game first, then pick it from the list.">
                            <ComboBox x:Name="ProcBox" IsEditable="True" MinWidth="220" PlaceholderText="Pick a program"
                                      DropDownOpened="ProcBox_DropDownOpened"
                                      TextSubmitted="ProcBox_TextSubmitted"
                                      SelectionChanged="ProcBox_SelectionChanged" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <TextBlock Text="Hotkeys" Style="{StaticResource GroupHeaderStyle}" />
                <tk:SettingsCard Header="Pause or resume" Description="While paused, you can type normally and the controller stays connected.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE769;" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel x:Name="PauseKeys" Orientation="Horizontal" Spacing="4" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Turn off" Description="Turns the keyboard controller off. Both hotkeys also work while the game is in front.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE71A;" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel x:Name="StopKeys" Orientation="Horizontal" Spacing="4" />
                </tk:SettingsCard>

                <TextBlock Text="Help" Style="{StaticResource GroupHeaderStyle}" />
                <tk:SettingsCard Header="How to use" Description="A short animated guide, from installing the driver to playing."
                                 IsClickEnabled="True" Click="Tutorial_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE897;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Header="See controllers in Windows"
                                 Description="Opens the Windows Game Controllers window. When the keyboard controller is on, it is listed there as an Xbox 360 controller."
                                 IsClickEnabled="True" Click="JoyCpl_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
