<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CoopWarrior.Pages.BindingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,40,0">
            <TextBlock Text="Key bindings" Style="{StaticResource PageTitleStyle}" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Reset_Click" AutomationProperties.Name="Reset all">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                    <TextBlock Text="Reset all" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentMargin}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}">
                <TextBlock Margin="1,8,0,0" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Click a button to change its key. One controller button can have several keys or mouse buttons. Keys light up while you hold them." />
                <StackPanel x:Name="Groups" Spacing="{StaticResource SettingsCardSpacing}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
