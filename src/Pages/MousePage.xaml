<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CoopWarrior.Pages.MousePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:c="using:CoopWarrior.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Mouse" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentMargin}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="{StaticResource SettingsCardSpacing}">

                <InfoBar x:Name="UnavailableBar" Severity="Warning" IsClosable="False" Title="Mouse movement does not work right now"
                         Message="Windows did not let Co-op Warrior read the mouse movement. Mouse buttons still work." />

                <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,12,0,0">
                    <Grid ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="240" Height="180">
                            <c:ControllerView x:Name="Pad" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Look around with the mouse" TextWrapping="Wrap" />
                            <TextBlock x:Name="HeroDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <tk:SettingsExpander x:Name="MoveExpander" Header="Mouse moves a stick" Margin="0,4,0,0"
                                     Description="Moving the mouse tilts a stick, so you can turn the camera like in a PC game. These settings are saved in the profile in use.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE962;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="MoveToggle" Toggled="Changed" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Stick">
                            <ComboBox x:Name="StickBox" MinWidth="220" SelectionChanged="Changed">
                                <ComboBoxItem Content="Right stick (camera)" />
                                <ComboBoxItem Content="Left stick (movement)" />
                            </ComboBox>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Sensitivity" Description="A higher number turns faster when you move the mouse the same distance.">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="SensitivityText" VerticalAlignment="Center" MinWidth="28" TextAlignment="Right" />
                                <Slider x:Name="SensitivitySlider" Width="220" Minimum="1" Maximum="10" StepFrequency="0.5" ValueChanged="Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Smallest tilt"
                                         Description="Games ignore a stick that is tilted only a little. This setting makes even a slow mouse move tilt the stick far enough for the game to notice. Lower it if the camera keeps moving on its own. Raise it if slow mouse moves do nothing.">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="DeadzoneText" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" />
                                <Slider x:Name="DeadzoneSlider" Width="220" Minimum="0" Maximum="40" StepFrequency="1" ValueChanged="Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Invert up and down">
                            <ToggleSwitch x:Name="InvertToggle" Toggled="Changed" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Keep the mouse pointer in the game window"
                                         Description="Holds the mouse pointer in the bottom-right corner of the game window, so your clicks stay in the game. The pointer is free again when you pause or switch to Co-op Warrior.">
                            <ToggleSwitch x:Name="LockToggle" Toggled="Changed" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <TextBlock Text="Buttons" Style="{StaticResource GroupHeaderStyle}" />
                <tk:SettingsCard Header="Use mouse buttons"
                                 Description="The left, right, middle and side mouse buttons press the controller buttons you choose on the Key bindings page.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B0;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ButtonsToggle" Toggled="Changed" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Choose what each mouse button does" IsClickEnabled="True" Click="Bindings_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
